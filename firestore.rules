rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection probe for boot health check
    match /test/connection {
      allow read: if true;
    }

    // Public service centers directory
    match /serviceCenters/{serviceCenterId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User scoped diagnostics
      match /diagnostics/{diagnosticId} {
        allow read, write: if isOwner(userId);
      }

      // User scoped repair estimates
      match /estimates/{estimateId} {
        allow read, write: if isOwner(userId);
      }

      // User scoped notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
